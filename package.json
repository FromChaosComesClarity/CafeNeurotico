{
  "name": "cafeneurotico",
  "version": "1.9.0",
  "description": "Cafe Neurotico — unified suite (Manager + GRINDER + CREMA in one AppImage)",
  "main": "main.js",
  "desktopName": "cafeneurotico.desktop",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "fetch-bin": "node scripts/fetch-binaries.mjs",
    "postinstall": "node scripts/fetch-binaries.mjs && electron-builder install-app-deps",
    "start": "electron .",
    "start:crema": "electron . --crema",
    "pack": "electron-builder --dir",
    "predist": "node scripts/fetch-binaries.mjs",
    "dist": "electron-builder --linux AppImage",
    "postdist": "D=/home/jose/Games/CNGM; F=CafeNeurotico.AppImage; [ -f $D/$F ] && mv $D/$F $D/CafeNeurotico_old.AppImage; cp dist/$F $D/$F && echo \"Deployed $F to $D\"",
    "dist:mac": "electron-builder --mac"
  },
  "author": "Shampoo is a Lie",
  "license": "GPL-3.0-or-later",
  "dependencies": {
    "@distube/ytdl-core": "^4.16.12",
    "adm-zip": "^0.6.0",
    "better-sqlite3": "^12.9.0",
    "gridstack": "^10.3.1",
    "howlongtobeat": "^1.8.0",
    "music-metadata": "^7.13.4"
  },
  "devDependencies": {
    "electron": "^41.3.0",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "com.cafeneurotico.suite",
    "productName": "Cafe Neurotico",
    "linux": {
      "target": "AppImage",
      "icon": "apps/manager/assets/icons/CNGM.svg",
      "category": "Game",
      "executableName": "cafeneurotico",
      "syncDesktopName": true,
      "desktop": {
        "entry": {
          "Name": "Cafe Neurotico",
          "StartupWMClass": "cafeneurotico"
        }
      },
      "extraResources": [
        {
          "from": "assets/bin/linux",
          "to": "assets/bin/linux",
          "filter": [
            "**/*"
          ]
        }
      ]
    },
    "appImage": {
      "artifactName": "CafeNeurotico.AppImage"
    },
    "files": [
      "main.js",
      "packages/**/*",
      "!**/assets/bin/**",
      "apps/manager/**/*",
      "apps/grinder/**/*",
      "apps/crema/**/*",
      "!apps/crema/assets/wallpapers/**",
      "!**/GameManagerConfig/**",
      "!**/GRINDERConfig/**"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.games",
      "icon": "apps/manager/assets/icons/CNGM.icns",
      "artifactName": "CafeNeurotico-${arch}.${ext}",
      "identity": null,
      "extraResources": [
        {
          "from": "assets/bin/darwin-arm64",
          "to": "assets/bin/darwin-arm64",
          "filter": [
            "**/*"
          ]
        }
      ]
    },
    "dmg": {
      "artifactName": "CafeNeurotico.dmg"
    }
  }
}
